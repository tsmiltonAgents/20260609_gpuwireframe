---
import '../styles/style.css';
import '../styles/hardware.css';
const base = (import.meta.env.BASE_URL.replace(/\/+$/, '')) + '/';

const motifs = [
  ['pcb-traces',     'PCB Traces',        'Copper signal routes, vias and travelling pulses'],
  ['edge-connector', 'Gold Edge Connector','A card edge with gold fingers and silkscreen'],
  ['rack-rails',     'Rack Rails',        'EIA-310 uprights with numbered U holes'],
  ['led-wall',       'LED Status Wall',   'Blinking port LEDs, datacenter NOC faceplate'],
  ['scope',          'Oscilloscope',      'Phosphor graticule with a live trace'],
  ['ribbon',         'Ribbon Harness',    'Flat rainbow ribbon cables and connectors'],
  ['heatsink',       'Heatsink + Fan',    'Extruded fins behind a spinning fan'],
  ['schematic',      'Schematic',         'Ink-on-cream symbols with a title block'],
  ['busbar',         'Copper Busbar',     'Power bars, bolts and rising current'],
  ['thermal',        'Thermal IR',        'Inferno hotspots with a FLIR crosshair'],
];
const hero = { line: 'AI infrastructure for AI security & verification.' };
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@300;400&family=IBM+Plex+Sans:wght@300;400;500;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <title>Side Channel Cloud — Hardware Lab</title>
</head>
<body>
  <div class="hw-top">
    <span><b>SIDE CHANNEL</b> // HARDWARE LAB</span>
    <a href={base}>← back to landing</a>
  </div>

  <nav class="hw-dots">
    {motifs.map((_, i) => <a href={`#m${i + 1}`} title={motifs[i][1]}></a>)}
  </nav>

  <main class="hw-page">
    {motifs.map(([id, name, desc], i) => (
      <section class="hw-sec" id={`m${i + 1}`} data-motif={id}>
        <div class="hw-stage"></div>
        <div class="hw-overlay">
          <div class="hw-hero">
            <h2>Side Channel <em>Cloud</em></h2>
            <p>{hero.line}</p>
          </div>
        </div>
        <div class="hw-cap">
          <span class="n">{String(i + 1).padStart(2, '0')} / 10</span>
          <span class="name">{name}</span>
          <span class="desc">{desc}</span>
        </div>
      </section>
    ))}
  </main>

  <script>
    import '../scripts/hardware.js';
  </script>
</body>
</html>
