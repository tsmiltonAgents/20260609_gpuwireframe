---
import '../styles/style.css';
const base = (import.meta.env.BASE_URL.replace(/\/+$/, '')) + '/';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Side Channel Cloud — Hardware Model Picker</title>
</head>
<body data-base={base}>
  <header class="topbar">
    <div class="brand"><span class="glyph"></span> <b>SIDE&nbsp;CHANNEL</b> <span>// CLOUD</span></div>
    <nav class="navlinks">
      <a href={base + 'gallery/'} class="active">Model picker</a>
      <a href={base}>Landing prototype</a>
    </nav>
  </header>

  <section class="gallery-head">
    <span class="tag">Hardware library</span>
    <h1>Rack &amp; tray models — dimensionally accurate.</h1>
    <p>Each model below is built to published dimensions (1U = 44.45 mm, EIA-310 /
       MGX widths) with correct tray counts, module placement and power/cooling
       topology — GB200 NVL72 rack and trays, DGX H100, full 42U H100 rack, HGX
       baseboard, PCIe. <b>Drag any model to rotate it in 3D.</b> <b>X-ray</b> removes
       sheet metal to expose internals; <b>Use this</b> loads it into the landing page.
       Your own <b>.glb / .gltf</b> CAD exports can be imported directly.</p>
  </section>

  <div class="controls-row">
    <button class="btn" id="xray-all">X-ray all</button>
    <label class="btn" for="glb-input">Import .glb / .gltf…</label>
    <input id="glb-input" type="file" accept=".glb,.gltf" multiple hidden />
    <span style="color:var(--text-dim);font-size:12px;">hover the legend to isolate a subsystem ↓</span>
  </div>
  <div class="controls-row"><div class="legend" id="legend" style="flex:1"></div></div>

  <div id="chosen-banner" style="display:none;max-width:1180px;margin:18px auto 0;padding:12px 18px;
       border:1px solid var(--magenta);border-radius:6px;background:rgba(255,79,166,0.08);
       color:var(--text);font-size:14px;"></div>

  <main class="grid" id="grid"></main>

  <script>
    import '../scripts/gallery.js';
  </script>
</body>
</html>
