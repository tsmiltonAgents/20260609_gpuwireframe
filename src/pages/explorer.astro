---
import '../styles/style.css';
import '../styles/themes.css';
import '../styles/themes-generated.css';
const base = (import.meta.env.BASE_URL.replace(/\/+$/, '')) + '/';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@300;400&family=IBM+Plex+Sans:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@300;400;500;700&family=Inter:wght@300;400;700;900&family=VT323&family=Playfair+Display:wght@400;700;900&family=Orbitron:wght@400;700;900&family=Cormorant+Garamond:wght@300;400;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:wght@300;400&family=Archivo+Black&display=swap" rel="stylesheet" />
  <title>Side Channel Cloud — Design Explorer</title>
  <script is:inline>
    (function(){var A={channels:'brutal-multi',channels2:'brutal-multi2'};var h=location.hash.replace('#','');var q=new URLSearchParams(location.search).get('theme');var w=A[h]||h||q||localStorage.getItem('scc-theme')||'amodo-dark';document.documentElement.dataset.theme=w;try{localStorage.setItem('scc-theme',w);}catch(e){}})();
  </script>
</head>
<body data-base={base}>
  <div class="page-frame"></div>
  <header class="topbar">
    <div class="brand"><span class="glyph"></span> <b>SIDE&nbsp;CHANNEL</b> <span>// CLOUD</span></div>
    <nav class="navlinks">
      <a href={base} data-n="01">Landing</a>
      <a href={base + 'gallery/'} data-n="02">Dev Model Picker</a>
      <a href={base + 'explorer/'} class="active" data-n="03">Explorer</a>
      <a href={base + '#channels'} class="chan">Channels</a>
      <a href="https://amododesign.com/" class="ext" data-n="//">Amodo Design</a>
    </nav>
  </header>

  <section class="gallery-head">
    <span class="tag">03 — Design Explorer</span>
    <h1>Every design, at a glance.</h1>
    <p>All <b id="ex-count">—</b> design systems as live thumbnails. <b>Click a card</b> to
       apply it and open the landing page, <b>☆</b> to shortlist. Cards re-skin with
       whatever design is currently active.</p>
  </section>

  <div class="controls-row">
    <button class="btn" id="ex-filter">★ Shortlist only</button>
    <span class="hint-note" id="ex-sl-count"></span>
  </div>

  <main class="ex-grid" id="ex-grid"></main>

  <script>
    import '../scripts/explorer.js';
  </script>
</body>
</html>
